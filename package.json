{
  "name": "droppilot",
  "version": "0.1.4",
  "description": "Planificador local y configurable de campañas de drops",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "author": "DropPilot contributors",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js src/adapters/*.test.js",
    "test:desktop": "node e2e/electron-smoke.mjs",
    "prepare:browser": "node scripts/prepare-browser.mjs",
    "build": "npm run prepare:browser && electron-builder --publish never",
    "dist:win": "npm run prepare:browser && electron-builder --win zip --x64 --publish never",
    "dist:linux": "npm run prepare:browser && electron-builder --linux zip --x64 --publish never",
    "dist:mac": "npm run prepare:browser && electron-builder --mac zip --publish never",
    "test:packaged": "node e2e/packaged-smoke.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "playwright": "^1.58.0"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.droppilot.desktop",
    "productName": "DropPilot",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/**/*.test.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".browsers",
        "to": "browsers",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "DropPilot-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": null
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/belcaik/DropPilot.git"
  }
}
